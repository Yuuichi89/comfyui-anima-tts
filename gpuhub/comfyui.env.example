# Einstellungen fuer gpuhub/start.sh. Kopieren nach
#   /root/autodl-fs/comfyui.env   (Dateispeicher: gilt fuer alle Instanzen der Region)
# oder
#   /root/autodl-tmp/comfyui.env  (nur diese Instanz, ueberschreibt die erste)
# und `chmod 600` setzen. Wirkt beim naechsten Start bzw. nach /opt/scripts/gpuhub/start.sh.
# Die Datei landet nicht im gespeicherten Image.

# Civitai-API-Token (ohne: Civitai-Modelle werden uebersprungen)
CIVITAI_TOKEN=

# Eigene Civitai-Liste "<ordner unter models>/<datei>=<modelVersionId>", Leerzeichen-getrennt
#CIVITAI_MODELS="diffusion_models/mein_modell.safetensors=1234567 loras/meine_lora.safetensors=7654321"

# 0 = nicht vorab laden (MOSS 8B + Audio-Tokenizer ca. 23 GB, ACE-Step ca. 10 GB)
#DOWNLOAD_MOSS_8B=0
#DOWNLOAD_ACE_STEP=0

# ComfyUI-Port (6006 = gpuhub "Custom Service") und Listen-Adresse.
# 127.0.0.1 = nur per SSH-Tunnel erreichbar.
#COMFYUI_PORT=6006
#COMFYUI_LISTEN=0.0.0.0
